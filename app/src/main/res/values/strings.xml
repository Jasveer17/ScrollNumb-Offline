    <!-- Legal / Privacy Policy / Terms -->
    <string name="legal_privacy_title">Privacy Policy</string>
    <string name="legal_privacy_updated">Last updated: %1$s</string>
    <string name="legal_privacy_intro">ScrollNumb (\"we\", \"us\", or \"our\") respects your privacy. This policy explains what data we collect, how we use it, and what we never do.</string>
    <string name="legal_privacy_h1">What we collect</string>
    <string name="legal_privacy_b1">Counts, time spent, XP, streaks, and preferences are stored on this device.</string>
    <string name="legal_privacy_h2">What we never collect</string>
    <string name="legal_privacy_b2">The accessibility service processes screen events on your device to recognise reels, count scrolling, and display reminders.</string>
    <string name="legal_privacy_h3">Permissions</string>
    <string name="legal_privacy_b3">• Accessibility service: counts scrolls on Instagram, YouTube, Facebook, Snapchat, LinkedIn, and TikTok, and shows the shield when you hit your daily limit.\n• Notifications: sends reminders.\n• Photo picker: optional, only used when you choose a profile picture.</string>
    <string name="legal_privacy_h4">Local profile</string>
    <string name="legal_privacy_b4">Your profile is stored on this device. Clearing app storage or uninstalling removes local progress. Earlier online versions may have stored account data separately.</string>
    <string name="legal_privacy_h5">Children</string>
    <string name="legal_privacy_b5">ScrollNumb is not intended for users under 13. We do not knowingly collect any data from children.</string>
    <string name="legal_privacy_h6">Changes</string>
    <string name="legal_privacy_b6">If we ever change this policy, we will update the date at the top and notify you inside the app before it takes effect.</string>
    <string name="legal_privacy_h7">Contact</string>
    <string name="legal_privacy_b7">For support, open the project issue tracker from Settings.</string>

    <string name="legal_terms_title">Terms of Service</string>
    <string name="legal_terms_updated">Last updated: %1$s</string>
    <string name="legal_terms_intro">By using ScrollNumb, you agree to the following terms. Please read them carefully.</string>
    <string name="legal_terms_h1">License</string>
    <string name="legal_terms_b1">ScrollNumb source code is available under the MIT License. Third-party assets remain subject to their respective licenses.</string>
    <string name="legal_terms_h2">Acceptable use</string>
    <string name="legal_terms_b2">You can study, modify, and share the source under its license. Use the app in accordance with the terms of the platforms you access.</string>
    <string name="legal_terms_h3">No medical advice</string>
    <string name="legal_terms_b3">ScrollNumb is a wellness tool, not a medical device. Nothing in the app constitutes medical, psychological, or professional advice. If you feel your screen habits are affecting your health, please consult a qualified professional.</string>
    <string name="legal_terms_h4">Limitation of liability</string>
    <string name="legal_terms_b4">The app is provided \"as is\". To the maximum extent permitted by law, we disclaim all warranties and shall not be liable for any indirect or consequential damages arising from your use of the app.</string>
    <string name="legal_terms_h5">Changes to terms</string>
    <string name="legal_terms_b5">We may update these terms from time to time. Continued use of the app after changes constitutes acceptance of the new terms.</string>
    <string name="legal_terms_h6">Contact</string>
    <string name="legal_terms_b6">For questions about these terms, use the project issue tracker.</string>

