    <!-- Onboarding slides -->
    <string name="onboarding_step1_title">Your brain starts\nfresh everyday</string>
    <string name="onboarding_step1_sub">Every morning is a clean slate. No reels, no fog, just a clear head.</string>
    <string name="onboarding_step2_title">Then you start\nscrolling.</string>
    <string name="onboarding_step2_sub">Short-form feeds are engineered to keep you hooked. One reel turns into a hundred.</string>
    <string name="onboarding_step3_title">Every reel drains\nyour brain more.</string>
    <string name="onboarding_step3_sub">Each scroll chips away at focus, attention, and the ability to be present.</string>
    <string name="onboarding_step4_title">Your ability to\nfocus drops.</string>
    <string name="onboarding_step4_sub">But the damage isn\'t permanent. Stop the bleed, and your brain resets.</string>
    <string name="onboarding_week_title">Within a week, you\'ll\nscroll less.</string>
    <string name="onboarding_week_sub">And your mind will feel clearer.</string>
    <string name="onboarding_benefit_focus">Focus better</string>
    <string name="onboarding_benefit_mental">Improved mental health</string>
    <string name="onboarding_benefit_sleep">Sleep calmly</string>
    <string name="onboarding_decide_title">You decide when to stop.\nNot the algorithm.</string>
    <string name="onboarding_decide_sub">Set a daily limit. When you hit it, reels lock until cooldown ends.</string>
    <string name="onboarding_limit_title">You can stop\ndoomscrolling with\nsmart limits.</string>
    <string name="onboarding_limit_sub">Choose how many reels you allow yourself per day.</string>
    <string name="onboarding_cooldown_title">When you reach your\nlimit, reels are locked\ntill cooldown ends.</string>
    <string name="onboarding_cooldown_sub">Pick how long to lock yourself out.</string>
    <string name="onboarding_widget_title">See your reel count\nfrom your home screen.</string>
    <string name="onboarding_widget_sub">Pin the ScrollNumb widget that shows your count and brain state at a glance.</string>
